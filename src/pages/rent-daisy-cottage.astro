---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site.js';
const title = 'Rates & Booking — Daisy Cottage | Cape Cod Vacation Rental';
const description = 'Rental rates for Daisy Cottage, one of the historic Days’ Cottages on Beach Point in North Truro, Cape Cod.';
---
<Base title={title} description={description}>
  <section class="section">
    <div class="container">
      <h1>Rates &amp; Booking</h1>
      <p>Rates start at <strong>$350/night</strong> and vary with the season and whether you book through Airbnb or directly with us.</p>
      <p>For now, the quickest way to see the exact rate for your dates &mdash; and to check whether the cottage is available &mdash; is right on our Airbnb listing. Take a look, and if you&rsquo;d prefer to book directly with us, get in touch at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
      <p class="text-center" style="margin-top:2rem">
        <a class="btn" href={SITE.airbnb} target="_blank" rel="noopener">Book Through Airbnb</a>
      </p>
    </div>
  </section>
</Base>
<style>
  h2.mt{margin-top:2.5rem}
  .rates{border-collapse:collapse;width:100%;max-width:560px;font-family:var(--font-body)}
  .rates td{padding:0.7rem 0.5rem;border-bottom:1px solid var(--color-line)}
  .rates td:last-child{text-align:right;font-weight:600;white-space:nowrap}
</style>
